{
  "presets": [
    "next/babel"
  ],
  "plugins": [
    ["@babel/plugin-proposal-decorators", { "legacy": true }],
    ["@babel/plugin-proposal-class-properties", { "loose": true }],
    [
      "styled-components",
      { "ssr": false, "displayName": true, "preprocess": false }
    ],
    ["inline-import", { "extensions": [".css"] }]
  ]
}
